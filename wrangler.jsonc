/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gestao-saude-cloudflare",
	"main": "worker/index.ts",
	"compatibility_date": "2026-07-02",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"ai": {
		"binding": "AI"
	},
	"ai_search_namespaces": [
		{
			"binding": "AI_SEARCH",
			"namespace": "default",
			"remote": true
		}
	],
	"vectorize": [
		{
			"binding": "VECTOR_INDEX",
			"index_name": "gestao-saude-vectorize"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2_BUCKET",
			"bucket_name": "gestao-saude-pdfs"
		}
	],
	"kv_namespaces": [
		{
			"binding": "GESTAO_SAUDE_KV",
			"id": "dcaddd26da33408488a9ba9d89db739e",
			"remote": true
		}
	],
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	"migrations": [
		{
			"tag": "v2",
			"deleted_classes": ["HealthApiContainer"]
		}
	],
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "80d5450c191d45b68da284c3bda78dc3"
		}
	],
	"queues": {
		"producers": [
			{
				"queue": "gestao-saude-pdf-queue",
				"binding": "PDF_PROCESS_QUEUE"
			}
		],
		"consumers": [
			{
				"queue": "gestao-saude-pdf-queue",
				"max_batch_size": 1,
				"max_batch_timeout": 5
			}
		]
	}
}